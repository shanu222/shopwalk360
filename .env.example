# =====================================================================
# ShopWalk 360 — environment variables
# =====================================================================

# ---------- VERCEL (frontend) — only this one ----------
# Your Railway API URL, no trailing slash
VITE_API_URL="https://your-api.up.railway.app"

# ---------- RAILWAY (backend API) ----------
NODE_ENV="production"
# Long random string, e.g. `openssl rand -hex 32`
AUTH_SECRET=""
# Your Vercel site(s), comma separated
CORS_ORIGINS="https://your-site.vercel.app,https://www.yourdomain.com"
# Admin sign-in for https://your-site/admin (password: 10+ characters)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Store Administrator"
# SQLite database on a Railway volume mounted at /data
DATABASE_PATH="/data/shopwalk360.db"
# Public URL of this API (used for media links when R2 is not configured)
PUBLIC_API_URL="https://your-api.up.railway.app"
# Optional: where uploads go if R2 is not configured (use the volume)
UPLOAD_DIR="/data/uploads"

# Cloudflare R2 (media uploads: videos, images, 3D models, captions)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public bucket URL or custom domain, e.g. https://media.yourdomain.com
R2_PUBLIC_URL=""

# Optional integrations (features stay off until set)
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
# AVATAR_PROVIDER_URL=""
# AVATAR_PROVIDER_KEY=""
# TRYON_PROVIDER_URL=""
# TRYON_PROVIDER_KEY=""
